# SFTP connection
NSE_SFTP_HOST=
NSE_SFTP_PORT=22
NSE_SFTP_USER=
# Either a password or a private key path
NSE_SFTP_PASSWORD=
NSE_SFTP_PRIVATE_KEY_PATH=

# Remote root where products live (e.g. /incoming/products)
NSE_SFTP_REMOTE_ROOT=

# Comma-separated product roots to monitor (example)
NSE_PRODUCTS=CM_EOD,CM_SNAPSHOT_5MIN

# Optional watchlist (comma separated symbols)
WATCHLIST=

# Scheduler interval in minutes
SCHEDULE_MINUTES=10

TIMEZONE=Asia/Kolkata

# Local sqlite file (relative to project)
DATABASE_URL=sqlite:///./data/market_data.db

# Symbol filtering configuration
# Path to instruments master CSV (symbol,isin,name,series,segment,status)
INSTRUMENTS_MASTER_PATH=

# Comma-separated allowed series (default: EQ for equities)
ALLOWED_SERIES=EQ

# Comma-separated symbol denylist to filter out (default: AAA,BBB,CCC,TEST,DUMMY)
SYMBOL_DENYLIST=AAA,BBB,CCC,TEST,DUMMY

# Enable symbol filtering during ingestion (default: true)
ENABLE_SYMBOL_FILTERING=true
